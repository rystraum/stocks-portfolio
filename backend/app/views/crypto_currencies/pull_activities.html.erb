<div class="flex flex-row p-4 mt-4">
  <%= link_to "#{chevron_left_icon} Back".html_safe, @crypto_currency, class: "btn btn-primary" %>
</div>

<div class="card m-4">
  <div class="card-header">
    <h4 class="card-header-title">
      Pulled Activities — <%= @crypto_currency.compound_ticker %>
      <small class="ml-2">last 50 trades from CoinsPH</small>
    </h4>
  </div>
  <div class="overflow-x-auto">
    <%= form_with url: import_activities_crypto_currency_path(@crypto_currency), method: :post, local: true do %>
      <table class="table table-striped card-table table-hover w-full">
        <thead>
          <tr>
            <th class="text-center">Import</th>
            <th class="hidden lg:table-cell text-right">Date</th>
            <th class="hidden lg:table-cell">Type</th>
            <th class="hidden lg:table-cell text-right">Amount</th>
            <th class="hidden lg:table-cell text-right">Fiat (PHP)</th>
            <th class="hidden lg:table-cell text-right">Fee</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @trades.each do |trade| %>
            <tr>
              <td class="text-center">
                <%= check_box_tag "trade_ids[]",
                                  trade[:upstream_trade_id],
                                  !trade[:already_recorded] && trade[:close_candidate].nil?,
                                  disabled: trade[:already_recorded] %>
              </td>
              <td class="hidden lg:table-cell text-right"><%= trade[:activity_date] %></td>
              <td class="hidden lg:table-cell"><%= trade[:activity_type].to_s.titleize %></td>
              <td class="hidden lg:table-cell text-right"><%= trade[:crypto_amount] %> <%= @crypto_currency.pretty_ticker %></td>
              <td class="hidden lg:table-cell text-right"><%= format_currency trade[:fiat_amount] %></td>
              <td class="hidden lg:table-cell text-right">
                <% if trade[:fee_fiat].positive? %>
                  <%= format_currency trade[:fee_fiat] %> PHP
                <% elsif trade[:fee_crypto].positive? %>
                  <%= trade[:fee_crypto] %> <%= @crypto_currency.pretty_ticker %>
                <% else %>
                  &nbsp;
                <% end %>
              </td>
              <td>
                <% if trade[:already_recorded] %>
                  <span class="badge badge-success">Already recorded</span>
                <% elsif trade[:close_candidate] %>
                  <% candidate = trade[:close_candidate] %>
                  <span class="badge badge-warning">
                    Close candidate:
                    <%= link_to "#{candidate.activity_date} #{candidate.activity_type} #{candidate.crypto_amount}",
                                edit_crypto_activity_path(candidate) %>
                  </span>
                <% else %>
                  <span class="badge badge-info">New</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="p-4">
        <%= submit_tag "Import Selected", class: "btn btn-success" %>
      </div>
    <% end %>
  </div>
</div>
