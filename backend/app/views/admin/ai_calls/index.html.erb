<%= render "shared/header", text: "AI Calls" %>

<table class="table table-striped m-6">
  <thead class="thead-dark">
    <tr>
      <th>Created</th>
      <th>Purpose</th>
      <th>Model</th>
      <th>Status</th>
      <th>Prompt</th>
      <th>Error</th>
      <th class="action-column">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @ai_calls.each do |call| %>
      <tr>
        <td><%= call.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= call.purpose %></td>
        <td><%= call.model %></td>
        <td><span class="badge <%= call.status == "completed" ? 'badge-soft-success' : 'badge-soft-danger' %>"><%= call.status %></span></td>
        <td><%= truncate(call.prompt, length: 80) %></td>
        <td><%= truncate(call.error_message, length: 60) %></td>
        <td class="text-right">
          <%= link_to "View", admin_ai_call_path(call), class: "btn btn-sm btn-primary" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
