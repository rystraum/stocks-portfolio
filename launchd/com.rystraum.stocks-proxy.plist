<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rystraum.stocks-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/caddy</string>
    <string>run</string>
    <string>--config</string>
    <string>/Volumes/Code/personal/stocks-portfolio/Caddyfile</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/Code/personal/stocks-portfolio</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>Nice</key>
  <integer>1</integer>

  <key>StandardOutPath</key>
  <string>/Users/rystraum/Library/Logs/stocks-portfolio/proxy.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/rystraum/Library/Logs/stocks-portfolio/proxy.error.log</string>
</dict>
</plist>
