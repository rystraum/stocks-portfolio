<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rystraum.stocks-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Volumes/Code/personal/stocks-portfolio/launchd/caddy-wrapper.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/Code/personal/stocks-portfolio</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/rystraum/Library/Logs/stocks-portfolio/proxy-user.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/rystraum/Library/Logs/stocks-portfolio/proxy-user.error.log</string>
</dict>
</plist>
